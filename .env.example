# App
PORT=3003
APP_BASE_URL=http://localhost:3003
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@host:5432/vybera

# Super-admin bootstrap (optional)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# Cloudflare R2 uploads (optional)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Twilio Verify signup OTP (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# Password-reset email (optional)
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=10

# PayU payments (optional)
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test
