# Copy to .env and fill in with YOUR OWN test credentials.
# Never commit .env. Never use the live client site's credentials here.
# Checklist of accounts to create: see CLAUDE.md -> "External accounts / keys you need".

# --- App (required) ---
PORT=3003
APP_BASE_URL=http://localhost:3003
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Reverse proxies in front of the app. Render/Heroku: 1. Local: 0.
# Needed for correct per-IP rate limits (req.ip).
TRUST_PROXY_HOPS=0

# --- Checkout rules (server is the price authority) ---
PLATFORM_FEE_PERCENT=8
GST_PERCENT=18
MAX_TICKETS_PER_ORDER=10
FREE_TICKETS_PER_USER_PER_EVENT=2

# --- PostgreSQL (required): your own local/Docker/Neon database ---
DATABASE_URL=postgresql://user:password@localhost:5432/ticketing_dev

# --- First super admin for your dev database (optional) ---
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# --- Twilio Verify, signup phone OTP (your own trial account) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# --- PayU payments: TEST mode merchant key/salt only ---
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test

# --- SMTP for password-reset email (Gmail app password or Mailtrap) ---
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=10

# --- Cloudflare R2 uploads (optional; your own bucket) ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Google sign-in: your own OAuth web client ID ---
GOOGLE_CLIENT_ID=
